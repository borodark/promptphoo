[
  {"t": "Hello {{name}}", "c": {"name": "World"}},
  {"t": "Hello {{ name | upper }}", "c": {"name": "world"}},
  {"t": "{% if premium %}Premium user{% else %}Free user{% endif %}", "c": {"premium": true}},
  {"t": "{% if premium %}Premium user{% else %}Free user{% endif %}", "c": {"premium": false}},
  {"t": "{{ flag }}|{{ n }}|{{ f }}|{{ nothing }}|{{ missing }}", "c": {"flag": true, "n": 3, "f": 2.5, "nothing": null}},
  {"t": "{{ items }}", "c": {"items": ["a", "b", 3]}},
  {"t": "{{ obj }}", "c": {"obj": {"a": 1}}},
  {"t": "{{ obj | dump }}", "c": {"obj": {"a": 1, "b": [true, null, "x"]}}},
  {"t": "{{ obj | dump(2) }}", "c": {"obj": {"a": 1}}},
  {"t": "{% if items %}yes{% else %}no{% endif %}", "c": {"items": []}},
  {"t": "{% if obj %}yes{% else %}no{% endif %}", "c": {"obj": {}}},
  {"t": "{% if not items %}empty{% else %}full{% endif %}", "c": {"items": []}},
  {"t": "{{ items.length }} {{ s.length }}", "c": {"items": [1, 2, 3], "s": "hello"}},
  {"t": "{{ s.toUpperCase() }} {{ s.includes('ell') }}", "c": {"s": "hello"}},
  {"t": "{% for k, v in obj %}{{ k }}={{ v }};{% endfor %}", "c": {"obj": {"a": 1, "b": 2}}},
  {"t": "{% for x in xs %}{{ loop.index }}:{{ x }}{% if not loop.last %},{% endif %}{% endfor %}", "c": {"xs": ["a", "b", "c"]}},
  {"t": "line1\n", "c": {}},
  {"t": "{{ a or 'fallback' }}|{{ b and 'yes' }}", "c": {"a": "", "b": []}},
  {"t": "{{ missing | default('dflt') }}|{{ empty | default('dflt') }}|{{ empty | default('dflt', true) }}", "c": {"empty": ""}},
  {"t": "{{ xs | join(', ') }}", "c": {"xs": [1, true, "z"]}},
  {"t": "{{ s | truncate(5) }}", "c": {"s": "abcdefghij"}},
  {"t": "{{ x === 1 }} {{ x !== 2 }}", "c": {"x": 1}},
  {"t": "{{ user.name }} {{ user.missing.deep }}", "c": {"user": {"name": "Ann"}}},
  {"t": "{{ s | replace('a', 'o') }} {{ s | capitalize }} {{ s | title }}", "c": {"s": "banana split"}},
  {"t": "{{ '{\"k\": 2}' | load | dump }}", "c": {}},
  {"t": "{{ xs | length }} {{ xs | first }} {{ xs | last }} {{ xs | reverse | join }}", "c": {"xs": [1, 2, 3]}},
  {"t": "{{ 1.0 }} {{ 0.1 + 0.2 }} {{ 10 / 4 }}", "c": {}},
  {"t": "{% set greeting = 'Hi ' + name %}{{ greeting }}", "c": {"name": "Bo"}},
  {"t": "{{ s | trim }}|{{ s | wordcount }}", "c": {"s": "  two words  "}},
  {"t": "{{ s | nl2br }}", "c": {"s": "a\nb"}},
  {"t": "{{ x if x else 'none' }}", "c": {"x": 0}},
  {"t": "{{ n | round }} {{ n | round(1) }} {{ n | int }}", "c": {"n": 3.456}}
